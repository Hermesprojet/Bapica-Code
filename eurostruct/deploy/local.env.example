# EUROSTRUCT — gabarit de l'exécution locale de production.
#
#     cp deploy/local.env.example deploy/local.env
#     # remplir, puis:
#     docker compose --env-file deploy/local.env up --build
#
# CE FICHIER EST UN GABARIT, ET IL EST VERSIONNE A CE TITRE. Il ne porte
# AUCUNE valeur réelle: ni mot de passe, ni clé, ni adresse d'instance. La
# copie remplie, elle, est ignorée par Git — voir `.gitignore`.
#
# UN CHAMP VIDE N'EST PAS UNE VALEUR PAR DEFAUT. L'API refuse de se déclarer
# prête sans configuration d'authentification, et `/ready` dit précisément ce
# qui manque, sans jamais recopier une valeur.

# --- base de données (locale, jetable) --------------------------------------
# Ce mot de passe ne protège qu'un conteneur sans port publié. Il n'en reste
# pas moins un mot de passe: on en met un, et on ne le commite pas.
POSTGRES_USER=eurostruct
POSTGRES_PASSWORD=
POSTGRES_DB=eurostruct

# --- vérification des jetons (côté API, secrets de RUNTIME) ------------------
# L'URL du JWKS de l'émetteur, son `iss` et son `aud`. Sans les trois,
# `/ready` reste rouge et les routes d'autorité rendent 503 — c'est voulu.
EUROSTRUCT_SUPABASE_JWKS_URL=
EUROSTRUCT_SUPABASE_ISSUER=
EUROSTRUCT_SUPABASE_AUDIENCE=authenticated
# ALGORITHMES ASYMETRIQUES UNIQUEMENT. La configuration refuse HS256: avec un
# secret partagé, quiconque peut vérifier peut aussi signer.
EUROSTRUCT_JWT_ALGORITHMS=RS256

# --- ce que le NAVIGATEUR doit joindre (public par nature) -------------------
# Ce ne sont pas les noms du réseau interne: c'est le navigateur de
# l'utilisateur qui appelle, et il ne connaît ni `api` ni `db`.
#
# Aucune de ces trois valeurs n'est inlinée dans l'image: le layout les lit à
# chaque requête et les dépose dans la page. Les changer est un redémarrage,
# pas une reconstruction.
EUROSTRUCT_PUBLIC_API_URL=http://127.0.0.1:8000
EUROSTRUCT_PUBLIC_SUPABASE_URL=
# La clé ANONYME de GoTrue. Elle désigne un projet et n'autorise rien par
# elle-même — ne jamais mettre ici une clé de service.
EUROSTRUCT_PUBLIC_SUPABASE_ANON_KEY=

# --- origines et ports ------------------------------------------------------
# Déclarées une à une. `*` est REFUSE par la configuration: un joker laisserait
# n'importe quelle page du web appeler l'API depuis le navigateur d'un
# utilisateur connecté.
EUROSTRUCT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PORT=8000
WEB_PORT=3000
