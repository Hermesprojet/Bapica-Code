# EUROSTRUCT — variables de la tranche applicative.
#
# CE FICHIER NE CONTIENT QUE DES NOMS. Aucune valeur reelle, aucun secret,
# aucune URL privee n'entre dans Git. Copiez-le, renseignez les valeurs
# localement, et ne versionnez jamais la copie.
#
#   cp eurostruct/api/.env.example .env
#   set -a && . ./.env && set +a

# --- Authentification Supabase -------------------------------------------
# Les trois sont EXIGES ensemble. Il n'existe aucun defaut: deviner l'un
# d'eux reviendrait a accepter les jetons d'un emetteur que personne n'a
# choisi. Sans eux, /ready rend 503 et les routes d'autorite refusent.
EUROSTRUCT_SUPABASE_JWKS_URL=
EUROSTRUCT_SUPABASE_ISSUER=
EUROSTRUCT_SUPABASE_AUDIENCE=

# Algorithmes acceptes, separes par des virgules. ASYMETRIQUES UNIQUEMENT.
# HS256 est refuse par la configuration elle-meme: avec un secret partage,
# quiconque peut verifier peut aussi signer, et le JWKS public deviendrait
# une cle de forge. Defaut: RS256.
EUROSTRUCT_JWT_ALGORITHMS=RS256

# Tolerance d'horloge en secondes, bornee a [0, 300]. Une tolerance large
# rend l'expiration decorative. Defaut: 60.
EUROSTRUCT_JWT_LEEWAY_S=60

# --- Base de donnees ------------------------------------------------------
# DSN PostgreSQL libpq. Aucune base par defaut: une connexion devinee irait
# vers une base que personne n'a designee, et l'autorite y ecrirait pour de
# vrai. Le compte utilise doit etre le LOGIN DE SERVICE declare dans
# `eurostruct.authority_backend_logins`, pas un superutilisateur.
EUROSTRUCT_DATABASE_URL=

# --- Origines autorisees (CORS) -------------------------------------------
# D'ou l'interface a le droit d'appeler l'API, separees par des virgules.
# « * » est REFUSE par la configuration elle-meme: un joker laisserait
# n'importe quelle page du web appeler cette API depuis le navigateur d'un
# utilisateur. Vide = le poste de developpement uniquement.
EUROSTRUCT_CORS_ORIGINS=

# --- Interface: LA CONFIGURATION DE RUNTIME (le chemin de production) ------
#
# DEUX FAMILLES DE VARIABLES, ET LA DIFFERENCE N'EST PAS COSMETIQUE.
#
# Next INLINE les `NEXT_PUBLIC_*` dans le bundle au moment du build: une image
# construite avec une cle anonyme la porte dans son JavaScript, definitivement,
# y compris apres qu'on a « change la variable d'environnement ». La meme image
# ne peut alors servir qu'un seul environnement.
#
# Les trois variables ci-dessous n'ont PAS ce prefixe. Le layout — un composant
# serveur — les lit A CHAQUE REQUETE et les depose dans la page. Les changer
# est un redemarrage, pas une reconstruction. C'est ce qu'utilisent les images
# et `compose.yaml`; voir `eurostruct/deploy/local.env.example`.
#
# Ou l'interface joint l'API. Publique par nature (elle part dans le
# navigateur): n'y mettez jamais autre chose qu'une URL de service.
# EN PRODUCTION, ce doit etre l'URL publique de l'API — jamais un localhost,
# qui designerait la machine du visiteur.
EUROSTRUCT_API_URL=http://127.0.0.1:8000

# Les deux variables publiques de Supabase, lues par l'interface. Elles
# partent dans le navigateur: la cle « anon » est faite pour cela et n'ouvre
# que ce que les politiques RLS autorisent. N'y mettez JAMAIS la cle
# `service_role`, qui les contourne toutes.
# Absentes, l'ecran de connexion dit qu'il n'est pas configure plutot que
# d'afficher un formulaire dont on sait qu'il refusera.
EUROSTRUCT_SUPABASE_URL=
EUROSTRUCT_SUPABASE_ANON_KEY=

# --- Interface: les equivalents de BUILD, pour `npm run dev` --------------
# Repli de commodite en developpement local sans conteneur. Ce ne sont PAS les
# variables de production: posees au build, elles sont figees dans le bundle.
NEXT_PUBLIC_EUROSTRUCT_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Ports du script de demarrage -----------------------------------------
# Lus par `eurostruct/dev.sh`. Vides, il prend 8000 et 3000.
EUROSTRUCT_PORT_API=
EUROSTRUCT_PORT_WEB=

# --- Exploitation ---------------------------------------------------------
# `true` en developpement local uniquement. N'assouplit AUCUNE verification:
# ajoute seulement le type de l'exception aux reponses 500.
EUROSTRUCT_DEBUG=

# --- Magasin d'objets: ou vivent les octets des livrables ------------------
# DEUX MAGASINS, ET RIEN D'AUTRE: `local` ou `s3`. Une valeur inconnue est
# REFUSEE plutot que ramenee au defaut — un « s4 » ou un « S3 » mal recopie
# ecrirait les livrables d'une production sur un disque ephemere, sans un mot.
#
# Vide vaut `local`, pour ne rien changer a un poste existant.
EUROSTRUCT_STORAGE_BACKEND=

# --- backend `local`: un repertoire du systeme de fichiers -------------------
# Un repertoire PERSISTANT, jamais /tmp. Un livrable est un fichier, et la
# ligne enregistree en base promet qu'on saura le relire; un repertoire
# temporaire ferait disparaitre les octets au prochain redemarrage en laissant
# les lignes derriere eux.
#
# ABSENTE, LA CREATION D'UN LIVRABLE REFUSE PAR UN 503 QUI NOMME CETTE
# VARIABLE. Il n'y a aucun repli: retomber sur un repertoire d'office
# laisserait enregistrer des documents introuvables. Les calculs, eux,
# continuent — produire un document et enregistrer un calcul sont deux choses
# differentes.
#
# SA LIMITE EST CONNUE ET NOMMEE: deux instances d'API derriere un repartiteur
# ne partagent pas ce disque, et la moitie des telechargements rendrait 503 sur
# des livrables parfaitement enregistres. C'est un magasin de poste de travail
# et de machine unique.
#
# `dev.sh` pose `eurostruct/.livrables`; la composition monte un volume nomme
# sur /var/lib/eurostruct/livrables.
EUROSTRUCT_STORAGE_DIR=

# --- backend `s3`: un compartiment S3-compatible, PRIVE ----------------------
# EPROUVE CONTRE UN MinIO REEL, localement et en integration continue
# (`db/test/stockage_s3.sh`, huit etapes). Cela etablit LE PROTOCOLE, et rien
# d'autre: ni AWS S3, ni Supabase Storage n'ont ete joints depuis ce depot, et
# `SUPABASE_UNVERIFIED` reste vrai.
#
# LES CINQ PREMIERES SONT OBLIGATOIRES quand le backend vaut `s3`, et AUCUNE
# n'a de valeur par defaut: deviner une region, un compartiment ou un endpoint
# ferait ecrire des livrables quelque part plutot que de refuser. Le 503 qui
# manque nomme les VARIABLES absentes, jamais leurs valeurs.
#
# AUCUN REPLI DE `s3` VERS LE DISQUE LOCAL, dans aucune circonstance.
EUROSTRUCT_S3_ENDPOINT=
EUROSTRUCT_S3_REGION=
EUROSTRUCT_S3_BUCKET=
EUROSTRUCT_S3_ACCESS_KEY_ID=
EUROSTRUCT_S3_SECRET_ACCESS_KEY=

# Le prefixe de cle, sous lequel toutes les cles sont ecrites. Il permet de
# partager un compartiment entre plusieurs usages sans les melanger. Les cles
# elles-memes derivent de l'organisation, du projet et de l'empreinte du
# contenu: `<prefixe>/<org>/<projet>/<sha256>.html`.
EUROSTRUCT_S3_PREFIX=

# Style CHEMIN (`http://hote/compartiment/cle`) par defaut — c'est ce que MinIO
# et la plupart des implementations compatibles attendent. `non` bascule sur le
# style « hote virtuel », qui exige une entree DNS par compartiment.
EUROSTRUCT_S3_PATH_STYLE=

# TLS. Vrai par defaut, et le rester est le seul choix defendable hors d'un
# reseau de composition local. `EUROSTRUCT_S3_CA_BUNDLE` designe un fichier de
# certificats — utile face a une autorite interne — et il doit exister.
EUROSTRUCT_S3_VERIFY_TLS=
EUROSTRUCT_S3_CA_BUNDLE=

# Chiffrement au repos, cote serveur: `AES256`, ou `aws:kms` avec un
# identifiant de cle. Vide = aucun en-tete de chiffrement envoye. Le declarer
# face a un magasin qui ne le porte pas fait REFUSER chaque depot, ce qui est
# preferable a un chiffrement qu'on croit actif et qui ne l'est pas.
EUROSTRUCT_S3_SSE=
EUROSTRUCT_S3_SSE_KMS_KEY_ID=

# ---------------------------------------------------------------------------
# LE RAPPROCHEMENT BASE / MAGASIN — un geste d'EXPLOITATION, pas de service
# ---------------------------------------------------------------------------
# `python3 -m eurostruct_api.reconciliation` compare `deliverables` au contenu
# du magasin et rend un rapport. Il ne modifie NI l'un NI l'autre: sa session
# PostgreSQL est ouverte en lecture seule, et le client S3 n'a aucune methode
# de suppression.
#
# LA VARIABLE EST DISTINCTE DE CELLE DU SERVICE, ET C'EST VOULU. Le
# rapprochement lit `deliverables` a travers TOUTES les organisations; le login
# applicatif, lui, n'a aucun privilege de table — c'est la frontiere que la
# matrice d'autorisation etablit. Les confondre donnerait un refus obscur.
#
# ELLE RESTE VIDE DANS UN DEPLOIEMENT DE SERVICE. Seule la machine qui execute
# le rapprochement la renseigne, avec un role dedie en lecture seule.
EUROSTRUCT_RECONCILIATION_DSN=
