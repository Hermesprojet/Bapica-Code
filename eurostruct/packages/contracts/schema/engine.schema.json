        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "formatted": {
          "title": "Formatted",
          "type": "string"
        },
        "latex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latex"
        },
        "numeric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenanceDTO"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "symbol",
        "description",
        "value",
        "unit",
        "formatted"
      ],
      "title": "CalcStepDTO",
      "type": "object"
    },
    "CheckDTO": {
      "additionalProperties": false,
      "properties": {
        "acting": {
          "title": "Acting",
          "type": "string"
        },
        "clause": {
          "$ref": "#/$defs/ClauseDTO"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "remedy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remedy"
        },
        "resisting": {
          "title": "Resisting",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckStatusDTO"
        },
        "utilisation": {
          "description": "E_d / R_d. Always reported, never just 'OK'.",
          "title": "Utilisation",
          "type": "number"
        }
      },
      "required": [
        "name",
        "status",
        "utilisation",
        "acting",
        "resisting",
        "clause"
      ],
      "title": "CheckDTO",
      "type": "object"
    },
    "CheckStatusDTO": {
      "enum": [
        "pass",
        "fail",
        "not_applicable"
      ],
      "title": "CheckStatusDTO",
      "type": "string"
    },
    "ClauseDTO": {
      "additionalProperties": false,
      "properties": {
        "cite": {
          "title": "Cite",
          "type": "string"
        },
        "clause": {
          "title": "Clause",
          "type": "string"
        },
        "equation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equation"
        },
        "national_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "National Note"
        },
        "standard": {
          "title": "Standard",
          "type": "string"
        }
      },
      "required": [
        "standard",
        "clause",
        "cite"
      ],
      "title": "ClauseDTO",
      "type": "object"
    },
    "DesignSituationDTO": {
      "enum": [
        "persistent",
        "transient",
        "accidental",
        "seismic"
      ],
      "title": "DesignSituationDTO",
      "type": "string"
    },
    "Ec2BeamFlexureRequest": {
      "additionalProperties": false,
      "description": "Input of the ULS bending verification of a rectangular section.",
      "properties": {
        "A_s_provided": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuantityDTO"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Area of the bars actually detailed. When omitted, the ULS check is made against the exact required area and its utilisation is 1,000."
        },
        "M_Ed": {
          "$ref": "#/$defs/QuantityDTO",
          "description": "Design moment from the governing EN 1990 combination. The engine does not build combinations."
        },
        "country": {
          "enum": [
            "BE",
            "FR",
            "ES",
            "DE"
          ],
          "title": "Country",
          "type": "string"
        },
        "element": {
          "default": "poutre",
          "description": "Element mark shown in the note.",
          "title": "Element",
          "type": "string"
        },
        "materials": {
          "$ref": "#/$defs/MaterialsDTO"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/ProvenanceDTO"
          },
          "description": "Origin of each input, keyed by symbol (b, h, d, M_Ed). Values extracted from a document must carry confirmed_by/confirmed_at.",
          "title": "Provenance",
          "type": "object"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sub-national region where it changes the parameters (Wallonie / Vlaanderen / Bruxelles, Land, Comunidad autonoma).",
          "title": "Region"
        },
        "section": {
          "$ref": "#/$defs/RectangularSectionDTO"
        },
        "situation": {
          "$ref": "#/$defs/DesignSituationDTO",
          "default": "persistent"
        },
        "strict_ndp": {
          "default": true,
          "description": "When true, an unverified National Annex parameter causes a refusal. Required for any deliverable intended to be signed; set false only for exploratory work.",
          "title": "Strict Ndp",
          "type": "boolean"
        }
      },
      "required": [
        "project_id",
        "country",
        "section",
        "materials",
        "M_Ed"
      ],
      "title": "Ec2BeamFlexureRequest",
      "type": "object"
    },
    "Ec2BeamFlexureResponse": {
      "additionalProperties": false,
      "description": "Output of a successful verification.\n\nA refusal is *not* represented here: it is returned as\n:class:`~eurostruct_engine.schemas.common.EngineErrorDTO` with HTTP 422, so\na caller cannot mistake a refusal for a result.",
      "properties": {
        "element": {
          "title": "Element",
          "type": "string"
        },
        "engine_version": {
          "description": "Stamped into the note de calcul and every drawing.",
          "title": "Engine Version",
          "type": "string"
        },
        "journal": {
          "$ref": "#/$defs/JournalDTO"
        },
        "ndp": {
          "$ref": "#/$defs/NdpSummaryDTO"
        },
        "result": {
          "$ref": "#/$defs/Ec2BeamFlexureResult"
        },
        "verification": {
          "$ref": "#/$defs/VerificationReportDTO"
        }
      },
      "required": [
        "element",
        "engine_version",
        "result",
        "verification",
        "journal",
        "ndp"
      ],
      "title": "Ec2BeamFlexureResponse",
      "type": "object"
    },
    "Ec2BeamFlexureResult": {
      "additionalProperties": false,
      "description": "Numeric outcome. Every field is also reachable through the journal.",
      "properties": {
        "As_max": {
          "$ref": "#/$defs/QuantityDTO",
          "description": "§9.2.1.1(3)"
        },
        "As_min": {
          "$ref": "#/$defs/QuantityDTO",
          "description": "§9.2.1.1(1), eq. (9.1N)"
        },
        "As_provided": {
          "$ref": "#/$defs/QuantityDTO"
        },
        "As_required": {
          "$ref": "#/$defs/QuantityDTO",
          "description": "max(As_strength, As_min)"
        },
        "As_strength": {
          "$ref": "#/$defs/QuantityDTO",
          "description": "Area required by strength alone"
        },
        "M_Rd": {
          "$ref": "#/$defs/QuantityDTO"
        },
        "eps_s": {
          "title": "Eps S",
          "type": "number"
        },
        "mu": {
          "title": "Mu",
          "type": "number"
        },
        "utilisation": {
          "title": "Utilisation",
          "type": "number"
        },
        "x": {
          "$ref": "#/$defs/QuantityDTO",
          "description": "Neutral axis depth"
        },
        "xi": {
          "title": "Xi",
          "type": "number"
        },
        "xi_lim": {
          "title": "Xi Lim",
          "type": "number"
        },
        "z": {
          "$ref": "#/$defs/QuantityDTO",
          "description": "Lever arm"
        }
      },
      "required": [
        "As_strength",
        "As_min",
        "As_max",
        "As_required",
        "As_provided",
        "x",
        "z",
        "M_Rd",
        "mu",
        "xi",
        "xi_lim",
        "eps_s",
        "utilisation"
      ],
      "title": "Ec2BeamFlexureResult",
      "type": "object"
    },
    "EngineErrorDTO": {
      "additionalProperties": false,
      "description": "A refusal. The API returns this with HTTP 422, never a partial result.",
      "properties": {
        "clause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clause"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "error": {
          "description": "Machine-readable class of refusal.",
          "enum": [
            "out_of_validation_domain",
            "unverified_national_parameter",
            "inconsistent_input",
            "unit_error"
          ],
          "title": "Error",
          "type": "string"
        },
        "what": {
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "error",
        "what",
        "detail"
      ],
      "title": "EngineErrorDTO",
      "type": "object"
    },
    "JournalDTO": {
      "additionalProperties": false,
      "properties": {
        "clauses": {
          "items": {
            "type": "string"
          },
          "title": "Clauses",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/CalcStepDTO"
          },
          "title": "Steps",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "steps",
        "clauses"
      ],
      "title": "JournalDTO",
      "type": "object"
    },
    "MaterialsDTO": {
      "additionalProperties": false,
      "properties": {
        "concrete_grade": {
          "description": "EN 1992-1-1 Table 3.1 designation.",
          "examples": [
            "C30/37"
          ],
          "title": "Concrete Grade",
          "type": "string"
        },
        "steel_grade": {
          "description": "Reinforcement designation.",
          "examples": [
            "B500B"
          ],
          "title": "Steel Grade",
          "type": "string"
        }
      },
      "required": [
        "concrete_grade",
        "steel_grade"
      ],
      "title": "MaterialsDTO",
      "type": "object"
    },
    "NdpEntryDTO": {
      "additionalProperties": false,
      "properties": {
        "clause": {
          "title": "Clause",
          "type": "string"
        },
        "en_recommended": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "En Recommended"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/NdpStatusDTO"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit",
        "status",
        "clause",
        "source"
      ],
      "title": "NdpEntryDTO",
      "type": "object"
    },
    "NdpStatusDTO": {
      "enum": [
        "en_recommended",
        "na_confirmed",
        "na_pending_verification"
      ],
      "title": "NdpStatusDTO",
      "type": "string"
    },
    "NdpSummaryDTO": {
      "additionalProperties": false,
      "description": "Printed verbatim in the 'referentiel applique' section of the note.",
      "properties": {
        "country": {
          "title": "Country",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/NdpEntryDTO"
          },
          "title": "Parameters",
          "type": "object"
        },
        "published_at": {
          "title": "Published At",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Region"
        },
        "strict": {
          "title": "Strict",
          "type": "boolean"
        },
        "unverified": {
          "description": "Parameters not yet confirmed against the published National Annex.",
          "items": {
            "type": "string"
          },
          "title": "Unverified",
          "type": "array"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "country",
        "region",
        "version",
        "published_at",
        "description",
        "strict",
        "unverified",
        "parameters"
      ],
      "title": "NdpSummaryDTO",
      "type": "object"
    },
    "ProvenanceDTO": {
      "additionalProperties": false,
      "description": "Where a value came from.\n\n``document_extraction`` values must already have been confirmed by a human\nbefore the orchestrator submits them: ``confirmed_by`` and ``confirmed_at``\nare how the engine's output can state that the gate was passed.",
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[x0, y0, x1, y1] in PDF points, so the UI can highlight the source.",
          "title": "Bbox"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed At"
        },
        "confirmed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed By"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKindDTO"
        },
        "ndp_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ndp Key"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "title": "ProvenanceDTO",
      "type": "object"
    },
    "ProvenanceKindDTO": {
      "enum": [
        "user_input",
        "document_extraction",
        "national_annex",
        "standard_constant",
        "derived"
      ],
      "title": "ProvenanceKindDTO",
      "type": "string"
    },
    "QuantityDTO": {
      "additionalProperties": false,
      "description": "A physical quantity with an explicit unit.",
      "properties": {
        "unit": {
          "description": "Pint-parsable unit, e.g. 'mm', 'kN*m', 'MPa', 'dimensionless'.",
          "examples": [
            "mm",
            "kN*m",
            "MPa"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "QuantityDTO",
      "type": "object"
    },
    "RebarScheduleRowDTO": {
      "additionalProperties": false,
      "description": "One line of the nomenclature — section 7.2.",
      "properties": {
        "comment": {
          "default": "",
          "title": "Comment",
          "type": "string"
        },
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "diameter_mm": {
          "title": "Diameter Mm",
          "type": "number"
        },
        "mark": {
          "title": "Mark",
          "type": "string"
        },
        "mass_kg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mass Kg"
        },
        "shape_code": {
          "description": "Shape code per EN ISO 3766",
          "title": "Shape Code",
          "type": "string"
        },
        "total_length_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Length Mm"
        },
        "unit_length_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Length Mm"
        }
      },
      "required": [
        "mark",
        "diameter_mm",
        "count",
        "unit_length_mm",
        "total_length_mm",
        "mass_kg",
        "shape_code"
      ],
      "title": "RebarScheduleRowDTO",
      "type": "object"
    },
    "RectangularSectionDTO": {
      "additionalProperties": false,
      "properties": {
        "b": {
          "$ref": "#/$defs/QuantityDTO",
          "description": "Width"
        },
        "d": {
          "$ref": "#/$defs/QuantityDTO",
          "description": "Effective depth to the tension reinforcement"
        },
        "h": {
          "$ref": "#/$defs/QuantityDTO",
          "description": "Overall depth"
        }
      },
      "required": [
        "b",
        "h",
        "d"
      ],
      "title": "RectangularSectionDTO",
      "type": "object"
    },
    "VerificationReportDTO": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckDTO"
