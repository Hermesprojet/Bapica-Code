{
  "$defs": {
    "BarRowDTO": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "diameter": {
          "description": "Nominal bar diameter, mm",
          "exclusiveMinimum": 0,
          "title": "Diameter",
          "type": "number"
        },
        "length": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Developed length, mm",
          "title": "Length"
        },
        "mark": {
          "title": "Mark",
          "type": "string"
        }
      },
      "required": [
        "count",
        "diameter",
        "mark"
      ],
      "title": "BarRowDTO",
      "type": "object"
    },
    "BeamSectionDrawingRequest": {
      "additionalProperties": false,
      "description": "Input of the DXF cross-section generator.",
      "properties": {
        "b": {
          "description": "Width, mm",
          "exclusiveMinimum": 0,
          "title": "B",
          "type": "number"
        },
        "bottom": {
          "items": {
            "$ref": "#/$defs/BarRowDTO"
          },
          "title": "Bottom",
          "type": "array"
        },
        "concrete_grade": {
          "default": "",
          "title": "Concrete Grade",
          "type": "string"
        },
        "cover": {
          "description": "Nominal cover c_nom, mm",
          "minimum": 0,
          "title": "Cover",
          "type": "number"
        },
        "date": {
          "default": "",
          "title": "Date",
          "type": "string"
        },
        "element": {
          "default": "",
          "title": "Element",
          "type": "string"
        },
        "exposure_class": {
          "default": "",
          "title": "Exposure Class",
          "type": "string"
        },
        "h": {
          "description": "Overall depth, mm",
          "exclusiveMinimum": 0,
          "title": "H",
          "type": "number"
        },
        "index": {
          "default": "A",
          "title": "Index",
          "type": "string"
        },
        "link_diameter": {
          "description": "Link diameter, mm",
          "minimum": 0,
          "title": "Link Diameter",
          "type": "number"
        },
        "link_mark": {
          "default": "C1",
          "title": "Link Mark",
          "type": "string"
        },
        "link_spacing": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link Spacing"
        },
        "plot_scale": {
          "default": 20.0,
          "exclusiveMinimum": 0,
          "title": "Plot Scale",
          "type": "number"
        },
        "project": {
          "default": "",
          "title": "Project",
          "type": "string"
        },
        "steel_grade": {
          "default": "",
          "title": "Steel Grade",
          "type": "string"
        },
        "top": {
          "items": {
            "$ref": "#/$defs/BarRowDTO"
          },
          "title": "Top",
          "type": "array"
        }
      },
      "required": [
        "b",
        "h",
        "cover",
        "link_diameter"
      ],
      "title": "BeamSectionDrawingRequest",
      "type": "object"
    },
    "CalcStepDTO": {
