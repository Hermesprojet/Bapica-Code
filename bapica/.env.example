# Bapica - Variables d'environnement
# Copiez ce fichier en .env.local et renseignez vos propres valeurs.
# ⚠️ Ne committez JAMAIS de vraies clés secrètes dans le dépôt.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_supabase
# Clé service_role (serveur uniquement, utilisée par le webhook Stripe — ne JAMAIS exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# Stripe - Test mode
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs
STRIPE_PRICE_ESSENTIAL=price_xxx
STRIPE_PRICE_PRO=price_xxx

# LLM APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Voice
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
ELEVENLABS_API_KEY=

# Video
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
RUNWAY_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Automation
N8N_URL=http://localhost:5678
N8N_API_KEY=

# Email
RESEND_API_KEY=
