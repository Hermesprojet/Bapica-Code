# Bapica — Variables d'environnement
# Copiez ce fichier en .env.local et renseignez vos propres valeurs.
# ⚠️ Ne committez JAMAIS de vraies clés secrètes dans le dépôt.
#
# Source de vérité (groupes + variables) : src/lib/env.ts
# Diagnostic en prod (admin) : GET /api/health/env
# ─────────────────────────────────────────────────────────────────────────────

# ── Cœur de l'app (REQUIS) ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optionnel : URL publique du site si différente de APP_URL (défaut : APP_URL)
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_supabase
# Clé service_role (serveur uniquement — ne JAMAIS exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# Moteur des agents (Anthropic Claude)
ANTHROPIC_API_KEY=

# ── Paiement (Stripe) ────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs (alias accepté : STRIPE_ESSENTIAL_PRICE_ID / STRIPE_PRO_PRICE_ID)
STRIPE_PRICE_ESSENTIAL=price_xxx
STRIPE_PRICE_PRO=price_xxx

# ── RAG documentaire + embeddings (OpenAI) ───────────────────────────────────
# Requiert aussi l'exécution de supabase-schema.sql (extension vector, tables/RPC)
OPENAI_API_KEY=

# ── Appels vocaux (Vapi) ─────────────────────────────────────────────────────
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
# UUID du numéro (pas le numéro lui-même)
VAPI_PHONE_NUMBER_ID=
# Optionnel : secret de vérification du webhook Vapi
VAPI_WEBHOOK_SECRET=

# ── Rendu vidéo (Runway / HeyGen / ElevenLabs) ───────────────────────────────
RUNWAY_API_KEY=
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
ELEVENLABS_API_KEY=
# Optionnel : id de la voix ElevenLabs (défaut : Rachel)
ELEVENLABS_VOICE_ID=

# ── Recherche de leads B2B (via /api/leads/search) — optionnel ───────────────
# Apollo.io (découverte par critères ; People Search API = plan Apollo payant)
APOLLO_API_KEY=
# Hunter.io (recherche par domaine d'entreprise ; API dès le plan gratuit)
HUNTER_API_KEY=

# ── Recherche internet sur l'entreprise du client — optionnel ────────────────
# SerpAPI (recherche web) ; sans, seul le site web du client est lu
SERPAPI_KEY=
# Google Places (avis / fiche établissement)
GOOGLE_PLACES_API_KEY=

# ── Messagerie — webhook unique /api/webhooks/messaging ──────────────────────
# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Verify token choisi librement, à répéter dans la config du webhook Meta (défaut : bapica_verify)
WHATSAPP_VERIFY_TOKEN=
# WhatsApp via Twilio (voie simplifiée, sans Meta Developers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro WhatsApp Twilio (ex : whatsapp:+14155238886 — sandbox Twilio pour tester)
TWILIO_WHATSAPP_NUMBER=
# Telegram Bot API (@BotFather) — bot mono-numéro de repli
TELEGRAM_BOT_TOKEN=
# Messenger (Meta) — jeton de la Page + verify token
MESSENGER_PAGE_TOKEN=
MESSENGER_VERIFY_TOKEN=

# ── Réseaux sociaux — LinkedIn ───────────────────────────────────────────────
# App avec produits "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optionnel : sinon déduit de NEXT_PUBLIC_APP_URL + /api/social/linkedin/callback
LINKEDIN_REDIRECT_URI=

# ── Administrateur(s) Bapica ─────────────────────────────────────────────────
# Accès à « Apprentissage » (insights produit). Emails séparés par des virgules.
# Lisible côté client (adresses, pas un secret).
NEXT_PUBLIC_ADMIN_EMAILS=

# ── Intégrations diverses — optionnel ────────────────────────────────────────
# Twenty CRM (webhook entrant)
TWENTY_WEBHOOK_SECRET=
# Email transactionnel (Resend)
RESEND_API_KEY=
# Automation (n8n)
N8N_URL=http://localhost:5678
N8N_API_KEY=
