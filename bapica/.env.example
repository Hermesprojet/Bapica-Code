# Bapica - Variables d'environnement
# Copiez ce fichier en .env.local et renseignez vos propres valeurs.
# ⚠️ Ne committez JAMAIS de vraies clés secrètes dans le dépôt.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_supabase
# Clé service_role (serveur uniquement, utilisée par le webhook Stripe — ne JAMAIS exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# Stripe - Test mode
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs
STRIPE_PRICE_ESSENTIAL=price_xxx
STRIPE_PRICE_PRO=price_xxx

# LLM APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Voice
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
ELEVENLABS_API_KEY=
# Optionnel : id de la voix ElevenLabs (défaut : Rachel)
ELEVENLABS_VOICE_ID=

# Video
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
RUNWAY_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Automation
N8N_URL=http://localhost:5678
N8N_API_KEY=

# Réseaux sociaux — LinkedIn (app avec produits "Sign In OpenID Connect" + "Share on LinkedIn")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optionnel : sinon déduit de NEXT_PUBLIC_APP_URL + /api/social/linkedin/callback
LINKEDIN_REDIRECT_URI=

# Recherche web (recherche internet sur l'entreprise du client) — optionnel
SERPAPI_KEY=

# Prospection — recherche de contacts/leads B2B via /api/leads/search
# Apollo.io (découverte par critères ; People Search API = plan Apollo payant)
APOLLO_API_KEY=
# Hunter.io (recherche par domaine d'entreprise ; API dès le plan gratuit)
HUNTER_API_KEY=

# Messagerie (canaux WhatsApp / Telegram / Messenger) — webhook unique /api/webhooks/messaging
# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Verify token choisi librement, à répéter dans la config du webhook Meta (défaut : bapica_verify)
WHATSAPP_VERIFY_TOKEN=
# Telegram Bot API (@BotFather)
TELEGRAM_BOT_TOKEN=
# Messenger (Meta) — jeton de la Page + verify token
MESSENGER_PAGE_TOKEN=
MESSENGER_VERIFY_TOKEN=

# Email
RESEND_API_KEY=

# Vidéo / Images (Runway, HeyGen)
RUNWAY_API_KEY=key_...
HEYGEN_API_KEY=...
ELEVENLABS_API_KEY=...
